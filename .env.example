# Sanity — content is edited in the separate studio repo (studio-sds-handicrafts).
# The project id and dataset are public; they're also in the studio's config.
NEXT_PUBLIC_SANITY_PROJECT_ID=pxzvfqmj
NEXT_PUBLIC_SANITY_DATASET=production

# Shared secret for the publish -> revalidate webhook. Generate your own
# (`openssl rand -base64 32`) and paste the same value into the webhook's
# "Secret" field at sanity.io/manage. Keep this one out of git.
SANITY_REVALIDATE_SECRET=
